{
  "name": "external-mines-programmator",
  "version": "1.0.0",
  "description": "Web application for visual programming of bots in the Mines game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "node --test src/js/**/*.test.js",
    "format": "prettier --config config/prettier.config.cjs --ignore-path config/prettierignore --write .",
    "format:check": "prettier --config config/prettier.config.cjs --ignore-path config/prettierignore --check .",
    "lint:css": "stylelint src/css/**/*.css --config config/stylelint-entry.config.cjs --fix",
    "lint:css:check": "stylelint src/css/**/*.css --config config/stylelint-entry.config.cjs",
    "lint:js": "eslint src/js/**/*.js --config config/eslint-entry.config.js --fix",
    "lint:js:check": "eslint src/js/**/*.js --config config/eslint-entry.config.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:check": "npm run lint:js:check && npm run lint:css:check",
    "lint:watch": "onchange 'src/**/*.{js,css}' -- npm run lint",
    "clean": "rm -rf dist",
    "build:clean": "npm run clean && npm run build",
    "quality": "npm run lint:check && npm run format:check && npx markdownlint README.md && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murasamadsp/External-Mines-Programmator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/murasamadsp/External-Mines-Programmator/issues"
  },
  "homepage": "https://github.com/murasamadsp/External-Mines-Programmator#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-legacy": "^7.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "markdownlint-cli": "^0.46.0",
    "onchange": "^7.1.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.3",
    "stylelint": "^16.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-full-reload": "^1.2.0"
  },
  "dependencies": {
    "lzma": "^2.3.2"
  }
}
